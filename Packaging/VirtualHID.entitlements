<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app create the virtual gamepad. macOS only honours this when Apple has granted it
	     to your developer team (with a matching provisioning profile). See README: Virtual gamepad. -->
	<key>com.apple.developer.hid.virtual.device</key>
	<true/>
</dict>
</plist>
